# Copy this file to .env for local testing, or set these variables in production.
# Do not commit real passwords or app passwords.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-sender@gmail.com
CONTACT_EMAIL_RECIPIENTS=arsenalterra@gmail.com
DEBUG=false
ALLOWED_HOSTS=.onrender.com,arsenalterraplanagem.com.br,www.arsenalterraplanagem.com.br
CSRF_TRUSTED_ORIGINS=https://arsenalterraplanagem.com.br,https://www.arsenalterraplanagem.com.br
SECRET_KEY=replace-with-a-long-random-secret
